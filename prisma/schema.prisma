generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id          Int      @id @default(1)
  homeImage   String   @default("default.jpg")
  aboutText   String
  
  aboutImage  String?  @default("/images/profil.png")
  aboutDetail String?
  cvUrl       String?
  contentWidgetCode String?

  // API Settings
  youtubeApiKey     String?
  youtubeChannelId  String?
  rapidApiKey       String?
  instagramUsername String?
  tiktokUsername    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  description String?
  image       String   // URL from UploadThing
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  image       String   // URL from UploadThing
  link        String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Message {
  id          String   @id @default(uuid())
  name        String
  email       String
  message     String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Timeline {
  id          String   @id @default(uuid())
  year        String
  title       String
  description String
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id          String   @id @default(uuid())
  period      String
  title       String
  description String
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SocialContent {
  id          String   @id @default(uuid())
  platform    String   // YouTube, TikTok, Instagram
  title       String
  image       String   // URL from UploadThing or API thumbnail
  link        String?
  order       Int      @default(0)
  isAutoSynced Boolean @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServiceCard {
  id          String   @id @default(uuid())
  title       String
  description String
  iconName    String   // Icon identifier, e.g. HiGlobeAlt, HiVideoCamera, HiDeviceGamepad2
  link        String?  // Optional link if it should be clickable
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
